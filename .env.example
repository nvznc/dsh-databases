# ── Conexión por defecto (equivale a la conexión llamada "default") ─────────
# Puede ser cualquier motor soportado: mssql | mysql | postgres
MSSQL_ENGINE=mssql
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=master

# Credenciales. Recomendado: un login de solo lectura por motor (ver sql/)
MSSQL_USER=mcp_sql
MSSQL_PASSWORD=cambia-esta-clave

# ── TLS ─────────────────────────────────────────────────────────────────────
# mssql: encrypt + trust (servidor local con certificado autofirmado)
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ── Límites ─────────────────────────────────────────────────────────────────
MSSQL_MAX_ROWS=200
MSSQL_QUERY_TIMEOUT_MS=30000
MSSQL_CONNECT_TIMEOUT_MS=15000

# ── Seguridad ───────────────────────────────────────────────────────────────
# run_query SIEMPRE es de solo lectura. execute_sql solo aparece con ALLOW_WRITE=true.
MSSQL_ALLOW_WRITE=false
# Lista blanca separada por comas; vacío = todas las bases accesibles.
MSSQL_ALLOWED_DATABASES=

# ── Varias conexiones ───────────────────────────────────────────────────────
# Archivo JSON con conexiones con nombre (ver configs/connections.example.json).
# Si se omite se usa configs/connections.json del paquete.
# MSSQL_CONFIGS=./configs/connections.json
# Conexión que se usa cuando la herramienta no indica "connection":
# DSH_MCP_SQL_CONNECTION=farmaluz
# Directorio donde save_connection guarda sus conexiones (por defecto ~/.dsh-mcp-sql):
# DSH_MCP_SQL_HOME=./.data

# debug | info | warn | error  (los logs van a stderr, nunca a stdout)
MSSQL_LOG_LEVEL=info
