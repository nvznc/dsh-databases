{
  "name": "dsh-databases",
  "version": "1.0.0",
  "description": "MCP server for DSH: explore and query SQL Server, MySQL/MariaDB and PostgreSQL with named connections",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "mcp", "mcp-server", "sqlserver", "mysql", "postgres", "database"],
  "bin": {
    "dsh-databases": "dist/index.js"
  },
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nvznc/dsh-databases"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.3",
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "index": "node scripts/generate-index.mjs",
    "index:check": "node scripts/validate-index.mjs site/index.json"
  },
  "files": [
    "dist",
    "configs/connections.example.json",
    ".env.example",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mssql": "^12.7.12",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
